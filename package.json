{
  "name": "reclaimed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Georgia Unclaimed Property CDR platform \u2014 compliance-first",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:compliance": "vitest run tests/compliance",
    "test:e2e": "playwright test",
    "verify:forms": "tsx --env-file-if-exists=.env.local scripts/verify-forms.ts",
    "verify:legend": "tsx --env-file-if-exists=.env.local scripts/verify-legend.ts",
    "verify:no-payments": "tsx --env-file-if-exists=.env.local scripts/verify-no-payments.ts",
    "verify:all": "pnpm verify:no-payments && pnpm verify:templates && pnpm verify:brand && pnpm verify:no-public-data && pnpm verify:public-surface && pnpm verify:acquisition && pnpm verify:comparison && pnpm verify:migrations && pnpm verify:forms && pnpm verify:legend",
    "verify:templates": "tsx --env-file-if-exists=.env.local scripts/verify-outbound-templates.ts",
    "ingest": "tsx --env-file-if-exists=.env.local scripts/ingest.ts",
    "fixture": "tsx --env-file-if-exists=.env.local scripts/generate-fixture.ts",
    "seed:rules": "tsx --env-file-if-exists=.env.local scripts/seed-state-rules.ts",
    "score": "tsx --env-file-if-exists=.env.local scripts/score.ts",
    "discover:fields": "tsx --env-file-if-exists=.env.local scripts/discover-form-fields.ts",
    "verify:no-public-data": "tsx --env-file-if-exists=.env.local scripts/verify-no-public-properties.ts",
    "verify:brand": "tsx --env-file-if-exists=.env.local scripts/verify-brand.ts",
    "verify:migrations": "tsx --env-file-if-exists=.env.local scripts/verify-migrations.ts",
    "bootstrap:admin": "tsx --env-file-if-exists=.env.local scripts/bootstrap-admin.ts",
    "verify:public-surface": "tsx --env-file-if-exists=.env.local scripts/verify-public-surface.ts",
    "acquire": "tsx --env-file-if-exists=.env.local scripts/acquire.ts",
    "verify:acquisition": "tsx --env-file-if-exists=.env.local scripts/verify-acquisition.ts",
    "watch:sources": "tsx --env-file-if-exists=.env.local scripts/watch-sources.ts",
    "probe:authority": "tsx --env-file-if-exists=.env.local scripts/probe-authority.ts",
    "snapshot:index": "tsx --env-file-if-exists=.env.local scripts/snapshot-index.ts",
    "verify:comparison": "tsx --env-file-if-exists=.env.local scripts/verify-comparison.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "next": "^16.3.1",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "unpdf": "^1.8.1",
    "vitest": "^4.1.11"
  }
}
