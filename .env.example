# ─────────────────────────────────────────────────────────────────────────────
# CDR REGISTRATION — the kill switch. O.C.G.A. § 44-12-239.2(a)(10).
#
# You may BUILD before registering. You may not SEND before registering.
# Leave as `unregistered` until DOR issues a registration number.
# ─────────────────────────────────────────────────────────────────────────────
CDR_REGISTRATION_STATUS=unregistered
CDR_REGISTRATION_NUMBER=
CDR_REGISTRATION_EXPIRES_AT=

# ─────────────────────────────────────────────────────────────────────────────
# LEGALLY-UNRESOLVED CAPABILITIES — both default OFF. Read the warning in
# lib/compliance/featureFlags.ts before enabling either.
# ─────────────────────────────────────────────────────────────────────────────
# O.C.G.A. § 43-38-3(3)(C) private-detective question is UNRESOLVED.
ENABLE_EXTERNAL_SKIPTRACE=false
# Georgia has NOT enacted general RON. ADMIN-2025-03 out-of-state path UNVERIFIED.
ENABLE_RON_SIGNATURE=false

# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# BRAND — checked against the § 44-12-239(g) denylist by `pnpm verify:brand`.
# ─────────────────────────────────────────────────────────────────────────────
CDR_ENTITY_NAME=
CDR_MAILING_ADDRESS=

# NOTE: there is NO payments configuration and there must never be one.
# § 44-12-239.2(a)(12) bans receipt OR SOLICITATION of advance consideration.
